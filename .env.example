# Образец настроек. Скопируйте в .env (он в .gitignore) и заполните. Пароли и ключи — только здесь, не в коде.

# Адрес кабинета
DOMAIN=b2b.styx-naturcosmetic.ru
APP_URL=https://b2b.styx-naturcosmetic.ru
PORT=8080

# Проверка организаций по ИНН и подсказки адреса
DADATA_TOKEN=
DADATA_SECRET=

# База и резервные копии (в Docker уже заданы: /app/data)
# DB_PATH=data/styx.sqlite
# BACKUP_DIR=data/backups
BACKUP_KEEP=14

# Новые клиенты попадают в кабинет только после подтверждения менеджером (0 — сразу)
REQUIRE_APPROVAL=1

# Почта: заказы, регистрации, сброс пароля
ORDER_MAIL_TO=
ORDER_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ORDER_MAIL_CLIENT_COPY=1
